{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DnsProxy": {
    "BaseDnsServer": "127.0.0.1",
    "BaseDnsPort": 53,
    "CertificatePath": "/etc/letsencrypt/live/dns.example.net/certificate.pfx",
    "DotPort": 853,
    "DohPort": 443,
    "MaxConcurrentUpstreamQueries": 256,
    "MaxTlsConnections": 256,
    "MaxQueriesPerTlsConnection": 8,
    "MaxDohConnections": 512,
    "MaxConcurrentDohRequests": 256,
    "MaxQueuedDohRequests": 256,
    "UdpTimeout": "00:00:03",
    "TcpFallbackTimeout": "00:00:05",
    "TlsHandshakeTimeout": "00:00:10",
    "TlsIdleTimeout": "00:00:30"
  }
}
